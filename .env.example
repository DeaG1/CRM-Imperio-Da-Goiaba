# --- Desenvolvimento ---
# Sem DATABASE_URL o app usa PGlite (Postgres embutido) em PGLITE_DIR.
# PGLITE_DIR=.data/pglite

# --- Comandos no banco de produção (npm run db:migrate / db:seed / db -- backup|restore) ---
# Supabase: Project Settings → Database → "Direct connection".
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# Aplica migrações automaticamente na primeira requisição (dev e servidor Node; o Worker nunca aplica)
# DB_AUTO_MIGRATE=true

# Senhas dos usuários criados pelo seed (padrão: admin123 / func123 — troque em produção!)
# SEED_ADMIN_PASSWORD=
# SEED_FUNC_PASSWORD=

# No Cloudflare Workers o banco vem do binding HYPERDRIVE (wrangler.jsonc), não daqui.
