{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Publicar na conta Cloudflare nova (subdomínio gestao-crm.workers.dev),
  // nunca na conta "velasqui" (nome de concorrente do cliente; lá também está o crm-bigdog).
  "name": "crm-imperio-da-goiaba",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "crm-imperio-da-goiaba" }
  ],
  // Domínio próprio (quando houver): o domínio precisa estar na MESMA conta Cloudflare
  // deste Worker; no deploy a Cloudflare cria o DNS e o HTTPS sozinha. Exemplo:
  //   "routes": [{ "pattern": "crm.seudominio.com.br", "custom_domain": true }],
  // Sem domínio próprio, o endereço é https://crm.<subdomínio-da-conta>.workers.dev
  // — nesta conta: https://crm-imperio-da-goiaba.gestao-crm.workers.dev (um Worker por cliente: crm-<cliente>)
  // Banco: Supabase (Postgres) via Hyperdrive "crm-imperio-da-goiaba-db" (conta gestao-crm),
  // criado com a Direct connection do Supabase. CACHE DO HYPERDRIVE DESLIGADO (o CRM precisa
  // sempre do dado mais recente: sessões, saldos, vendas recém-salvas).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "524330f00a8d4a6d9f49b76b76f18312",
      // Só para a simulação local (wrangler dev / passo de deploy do OpenNext, que exige um
      // valor). Em produção o Worker usa o Hyperdrive real acima; este endereço nunca é usado.
      "localConnectionString": "postgres://local:local@127.0.0.1:5432/local"
    }
  ],
  // O banco (Supabase) fica nos EUA: o Smart Placement roda o Worker perto dele, então as
  // várias consultas de cada tela não atravessam o oceano — só a resposta final.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
